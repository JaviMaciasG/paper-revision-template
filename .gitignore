# Preserve author-maintained sources: no blanket exclusions for PDF/PS/EPS,
# .bib, .tikz, .ist, .xdy, .mp, .mf, .gnuplot, .table, .el, or .md5 files.
# Upstream numeric-extension rules can hide data; add project-specific rules
# if needed. Minted exclusions target cache directories and generated files,
# rather than every file whose name starts with _minted.

# Editor backups, autosave, swap files, and private histories.
*~
*.bak
*.sav
*.backup
*.tmp
.*.swp
.*.swo
.\#*
\#*\#
.texpadtmp/
.history/
.netrwhist
.emacs.desktop*
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/shelf/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# Operating-system metadata and local administrative files.
.DS_Store
.AppleDouble
._*
Thumbs.db
[Dd]esktop.ini
.Trash-*
.nfs*
.fuse_hidden*
~$*
.~lock*
/go.resume-codex.sh

# Reserved manuscript source archives; other ZIP assets remain trackable.
/original/paper.zip
/original/paper-original.zip
/revised[0-9]*/paper.zip
/revised[0-9]*/paper-revised[0-9]*.zip
/.removed-rounds/round[0-9]*-*/revised[0-9]*/paper.zip
/.removed-rounds/round[0-9]*-*/revised[0-9]*/paper-revised[0-9]*.zip

# Reserved stage-root PDF names. PDF figure assets remain trackable.
/original/paper.pdf
/original/paper-diff.pdf
/revised[0-9]*/paper.pdf
/revised[0-9]*/paper-diff.pdf
/reply[0-9]*/responses.pdf
/reply[0-9]*/responses-with-diff.pdf
/reply[0-9]*/editor.pdf
/reply[0-9]*/editor-with-diff.pdf
/reply[0-9]*/reviewer[0-9]*.pdf

# SyncTeX accompanies PDFs for editor navigation.
/original/*.synctex*
/revised[0-9]*/*.synctex*
/reply[0-9]*/*.synctex*

# Archived sources remain trackable; generated outputs keep the same exclusions.
/.removed-rounds/round[0-9]*-*/revised[0-9]*/paper.pdf
/.removed-rounds/round[0-9]*-*/revised[0-9]*/paper-diff.pdf
/.removed-rounds/round[0-9]*-*/reply[0-9]*/responses.pdf
/.removed-rounds/round[0-9]*-*/reply[0-9]*/responses-with-diff.pdf
/.removed-rounds/round[0-9]*-*/reply[0-9]*/editor.pdf
/.removed-rounds/round[0-9]*-*/reply[0-9]*/editor-with-diff.pdf
/.removed-rounds/round[0-9]*-*/reply[0-9]*/reviewer[0-9]*.pdf
/.removed-rounds/round[0-9]*-*/revised[0-9]*/*.synctex*
/.removed-rounds/round[0-9]*-*/reply[0-9]*/*.synctex*

# Live build/mutation locks are transient. Pristine reviewer baselines are tracked.
**/.template-lock/
**/.paper-template.*/

# Rendered project guides; Markdown sources remain tracked.
/README.pdf
/HOWTO.pdf

# Updater backups are local; the managed-file manifest remains trackable.
/.template-update/backups/
