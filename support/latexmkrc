# Ignore user latexmkrc files (the driver supplies -norc and this file).
$pdf_mode = 1;
$pdflatex = 'pdflatex -interaction=nonstopmode -halt-on-error -file-line-error -synctex=1 %O %S';
$bibtex_use = 2;
$max_repeat = 8;
# Keep BibTeX in the source directory: rebuttals use ../revisedN/paper.bib.
$bibtex_fudge = 0;
